@coreMosUrl = https://pre-core.mos.oict.cz/services/mosservice.asmx
@serviceKey = {{$processEnv CORE_MOS_SERVICE_KEY}}
@userName = toknoboydi@necub.com
@password = Test123+
@sessionId = d368327c-519a-4c04-9903-1e841ac0d05c
@returnUrl = pid-litacka://identifier-registration/

### Core MOS - AuthenticateLogin
# Copy AuthenticateLoginResult/Session/SessionID from the response into @sessionId above.
POST {{coreMosUrl}}
Content-Type: text/xml; charset=utf-8
SOAPAction: "globdata/AuthenticateLogin"

<?xml version="1.0" encoding="utf-8"?>
<soap:Envelope xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
               xmlns:xsd="http://www.w3.org/2001/XMLSchema"
               xmlns:soap="http://schemas.xmlsoap.org/soap/envelope/">
  <soap:Body>
    <AuthenticateLogin xmlns="globdata">
      <ServiceKey>{{serviceKey}}</ServiceKey>
      <UserName>{{userName}}</UserName>
      <Password>{{password}}</Password>
    </AuthenticateLogin>
  </soap:Body>
</soap:Envelope>

### Core MOS - InitiateTokenRegistration
# Development config:
# - CoreMos:BaseUrl = {{coreMosUrl}}
# - CoreMos:ServiceKey = {{serviceKey}}
# - IdentifierTokenization:ReturnUrl = {{returnUrl}}
#
# SessionID is not stored in appsettings. In the application it is populated
# from the current MOS session before calling InitiateTokenRegistration.
POST {{coreMosUrl}}
Content-Type: text/xml; charset=utf-8
SOAPAction: "globdata/InitiateTokenRegistration"

<?xml version="1.0" encoding="utf-8"?>
<soap:Envelope xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
               xmlns:xsd="http://www.w3.org/2001/XMLSchema"
               xmlns:soap="http://schemas.xmlsoap.org/soap/envelope/">
  <soap:Body>
    <InitiateTokenRegistration xmlns="globdata">
      <ServiceKey>{{serviceKey}}</ServiceKey>
      <SessionID>{{sessionId}}</SessionID>
      <EshopRedirectUrl>{{returnUrl}}</EshopRedirectUrl>
    </InitiateTokenRegistration>
  </soap:Body>
</soap:Envelope>
