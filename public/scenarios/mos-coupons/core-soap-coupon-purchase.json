{
  "version": 1,
  "name": "MOS Kupóny - Core SOAP",
  "description": "Přímé diagnostické scénáře nad Core MOS SOAP API pro vytvoření testovacího kupónu bez PidLitacka BE.",
  "scenarios": [
    {
      "id": "mos-coupon-test-purchase-soap",
      "title": "MOS - nákup testovacího kupónu",
      "description": "Vytvoří testovací kupón přímo přes MOSService.asmx: přihlášení, zjištění tarifů, přidání kupónu do objednávky a potvrzení platby.",
      "requiresAuth": true,
      "smoke": false,
      "manualInputRequired": true,
      "tags": ["coupons", "soap", "core-mos", "test-data", "purchase"],
      "app": {
        "section": "profile",
        "title": "Kupóny",
        "subtitle": "Přímé volání Core MOS"
      },
      "instructions": [
        "V panelu Přístup vložte Core MOS ServiceKey.",
        "Ve scénáři zadejte přepážkový MOS účet a heslo. Po přihlášení se SessionID uloží do kontextu.",
        "Krok zjištění tarifů nabídne použitelné tarify pro zónu P. Kvůli chování Core MOS se pro samotnou fixní zónu P do nákupu posílá cena 0.0000.",
        "Kupón se vytváří s IsTest=true, tedy jako testovací nákup vyloučený ze statistik a reportů.",
        "PaymentType ponechte 3 nebo 4. Hodnoty 1 a 2 by spouštěly platební bránu."
      ],
      "steps": [
        {
          "id": "mos-coupon-authenticate-login",
          "title": "Přihlásit se do Core MOS",
          "description": "Zavolá AuthenticateLogin a uloží SessionID pro další SOAP volání.",
          "fields": [
            {
              "name": "userName",
              "label": "MOS uživatel",
              "type": "text",
              "value": "",
              "placeholder": "Přepážkový účet"
            },
            {
              "name": "password",
              "label": "Heslo",
              "type": "password",
              "value": "",
              "placeholder": "Heslo přepážkového účtu"
            },
            {
              "name": "codeSms",
              "label": "SMS kód",
              "type": "text",
              "value": "",
              "placeholder": "Volitelné"
            }
          ],
          "request": {
            "method": "POST",
            "path": "/services/MOSservice.asmx",
            "contentType": "text/xml; charset=utf-8",
            "headers": {
              "SOAPAction": "\"globdata/AuthenticateLogin\""
            },
            "body": "<?xml version=\"1.0\" encoding=\"utf-8\"?>\n<soap:Envelope xmlns:xsi=\"http://www.w3.org/2001/XMLSchema-instance\" xmlns:xsd=\"http://www.w3.org/2001/XMLSchema\" xmlns:soap=\"http://schemas.xmlsoap.org/soap/envelope/\">\n  <soap:Body>\n    <AuthenticateLogin xmlns=\"globdata\">\n      <ServiceKey>{{auth.apiKey}}</ServiceKey>\n      <UserName>{{form.userName}}</UserName>\n      <Password>{{form.password}}</Password>\n      <CodeSMS>{{form.codeSms}}</CodeSMS>\n    </AuthenticateLogin>\n  </soap:Body>\n</soap:Envelope>"
          },
          "expected": {
            "status": 200,
            "assertions": [
              { "path": "$", "notEmpty": true }
            ]
          },
          "extractRegex": {
            "mosCouponSessionId": "<SessionID>([^<]+)</SessionID>"
          }
        },
        {
          "id": "mos-coupon-get-tokens",
          "title": "Načíst identifikátory",
          "description": "Načte dostupné tokeny/identifikátory přihlášeného MOS účtu. Vybraný identifikátor se použije pro zjištění tarifů a vytvoření kupónu.",
          "requiresContext": ["mosCouponSessionId"],
          "request": {
            "method": "POST",
            "path": "/services/MOSservice.asmx",
            "contentType": "text/xml; charset=utf-8",
            "headers": {
              "SOAPAction": "\"globdata/GetTokens\""
            },
            "body": "<?xml version=\"1.0\" encoding=\"utf-8\"?>\n<soap:Envelope xmlns:xsi=\"http://www.w3.org/2001/XMLSchema-instance\" xmlns:xsd=\"http://www.w3.org/2001/XMLSchema\" xmlns:soap=\"http://schemas.xmlsoap.org/soap/envelope/\">\n  <soap:Body>\n    <GetTokens xmlns=\"globdata\">\n      <ServiceKey>{{auth.apiKey}}</ServiceKey>\n      <SessionID>{{context.mosCouponSessionId}}</SessionID>\n      <GetOnlyAvailableTokens>true</GetOnlyAvailableTokens>\n    </GetTokens>\n  </soap:Body>\n</soap:Envelope>"
          },
          "expected": {
            "status": 200
          },
          "selection": {
            "buttonLabel": "Použít identifikátor",
            "selectedButtonLabel": "Vybráno",
            "sourceRegex": {
              "itemPattern": "<TokenEx[^>]*>([\\s\\S]*?)</TokenEx>",
              "fields": {
                "tokenId": "<TokenID>([^<]+)</TokenID>",
                "name": "<Name>([^<]*)</Name>",
                "token": "<Token>([^<]*)</Token>",
                "customerId": "<CustomerIDx>([^<]+)</CustomerIDx>",
                "identifierType": "<IdentifierType>([^<]*)</IdentifierType>",
                "maskedPan": "<MaskedPAN>([^<]*)</MaskedPAN>",
                "cln": "<CLN>([^<]*)</CLN>",
                "active": "<Active>([^<]+)</Active>"
              }
            },
            "store": {
              "mosCouponTokenId": "$.tokenId",
              "mosCouponCustomerId": "$.customerId"
            }
          }
        },
        {
          "id": "mos-coupon-get-token-tariffs",
          "title": "Zjistit dostupné tarify pro token",
          "description": "Pomocné volání GetTokenTariffs pro zjištění TariffID, zón a ceny. Výsledek použijte v dalším kroku.",
          "requiresContext": ["mosCouponSessionId"],
          "fields": [
            {
              "name": "tokenId",
              "label": "TokenID",
              "type": "number",
              "value": "{{context.mosCouponTokenId}}",
              "placeholder": "ID tokenu / identifikátoru"
            },
            {
              "name": "startDate",
              "label": "StartDate",
              "type": "date",
              "value": "{{today}}"
            }
          ],
          "request": {
            "method": "POST",
            "path": "/services/MOSservice.asmx",
            "contentType": "text/xml; charset=utf-8",
            "headers": {
              "SOAPAction": "\"globdata/GetTokenTariffs\""
            },
            "body": "<?xml version=\"1.0\" encoding=\"utf-8\"?>\n<soap:Envelope xmlns:xsi=\"http://www.w3.org/2001/XMLSchema-instance\" xmlns:xsd=\"http://www.w3.org/2001/XMLSchema\" xmlns:soap=\"http://schemas.xmlsoap.org/soap/envelope/\">\n  <soap:Body>\n    <GetTokenTariffs xmlns=\"globdata\">\n      <ServiceKey>{{auth.apiKey}}</ServiceKey>\n      <SessionID>{{context.mosCouponSessionId}}</SessionID>\n      <TokenID>{{form.tokenId}}</TokenID>\n      <StartDate>{{form.startDate}}</StartDate>\n    </GetTokenTariffs>\n  </soap:Body>\n</soap:Envelope>"
          },
          "remember": {
            "mosCouponTokenId": "{{form.tokenId}}"
          },
          "expected": {
            "status": 200
          },
          "selection": {
            "buttonLabel": "Použít tarif",
            "selectedButtonLabel": "Tarif vybrán",
            "emptyTitle": "Žádný použitelný tarif",
            "emptyText": "MOS nevrátil žádný tarif se zónou P. Bez platné kombinace tarifu, zóny a ceny nejde pokračovat.",
            "sourceRegex": {
              "itemPattern": "<TariffBuy[^>]*>([\\s\\S]*?<ZoneName>P</ZoneName>[\\s\\S]*?)</TariffBuy>",
              "fields": {
                "tariffId": "<TariffID>([^<]+)</TariffID>",
                "customerId": "<CustomerID>([^<]+)</CustomerID>",
                "tariffName": "<TariffName>([^<]*)</TariffName>",
                "tariffProfileName": "<TariffProfileName>([^<]*)</TariffProfileName>",
                "validFrom": "<NewCouponValidFrom>([^<]+)</NewCouponValidFrom>",
                "validTill": "<NewCouponValidTill>([^<]+)</NewCouponValidTill>",
                "tariffZoneId": "<Zone>\\s*<TariffZoneID>([^<]+)</TariffZoneID>\\s*<ZoneName>P</ZoneName>",
                "zoneName": "<Zone>\\s*<TariffZoneID>[^<]+</TariffZoneID>\\s*<ZoneName>(P)</ZoneName>",
                "displayPrice": "<Zone>\\s*<TariffZoneID>[^<]+</TariffZoneID>\\s*<ZoneName>P</ZoneName>\\s*<Price>([^<]+)</Price>"
              }
            },
            "store": {
              "mosCouponSuggestedTariffId": "$.tariffId",
              "mosCouponCustomerId": "$.customerId",
              "mosCouponSuggestedZoneId": "$.tariffZoneId",
              "mosCouponSuggestedZoneName": "$.zoneName",
              "mosCouponSuggestedDisplayPrice": "$.displayPrice",
              "mosCouponSuggestedPrice": {
                "literal": "0.0000"
              },
              "mosCouponSuggestedValidFrom": "$.validFrom",
              "mosCouponSuggestedValidTill": "$.validTill"
            }
          }
        },
        {
          "id": "mos-coupon-add-item-to-order",
          "title": "Přidat testovací kupón do objednávky",
          "description": "Zavolá AddItemToOrder s NewCoupon a IsTest=true. Pokud OrderID není zadán, MOS vytvoří novou objednávku.",
          "requiresContext": ["mosCouponSessionId", "mosCouponTokenId", "mosCouponSuggestedTariffId", "mosCouponSuggestedZoneId", "mosCouponSuggestedPrice"],
          "fields": [
            {
              "name": "customerId",
              "label": "CustomerID",
              "type": "number",
              "value": "{{context.mosCouponCustomerId}}",
              "placeholder": "ID zákazníka z vybraného identifikátoru"
            },
            {
              "name": "tokenId",
              "label": "TokenID",
              "type": "number",
              "value": "{{context.mosCouponTokenId}}"
            },
            {
              "name": "tariffId",
              "label": "TariffID",
              "type": "number",
              "value": "{{context.mosCouponSuggestedTariffId}}",
              "placeholder": "TariffID z předchozí odpovědi"
            },
            {
              "name": "tariffZoneId",
              "label": "TariffZoneID",
              "type": "number",
              "value": "{{context.mosCouponSuggestedZoneId}}",
              "placeholder": "Zóna tarifu"
            },
            {
              "name": "price",
              "label": "Cena",
              "type": "number",
              "value": "{{context.mosCouponSuggestedPrice}}",
              "step": 0.01,
              "placeholder": "Pro samotnou zónu P počítá Core MOS cenu 0"
            },
            {
              "name": "description",
              "label": "Popis kupónu",
              "type": "text",
              "value": "Test kupon - zona P",
              "placeholder": "Description je v Core MOS povinný údaj pro vložení kupónu"
            },
            {
              "name": "validFrom",
              "label": "ValidFrom",
              "type": "text",
              "value": "{{context.mosCouponSuggestedValidFrom}}"
            },
            {
              "name": "validTill",
              "label": "ValidTill",
              "type": "text",
              "value": "{{context.mosCouponSuggestedValidTill}}"
            }
          ],
          "request": {
            "method": "POST",
            "path": "/services/MOSservice.asmx",
            "contentType": "text/xml; charset=utf-8",
            "headers": {
              "SOAPAction": "\"globdata/AddItemToOrder\""
            },
            "body": "<?xml version=\"1.0\" encoding=\"utf-8\"?>\n<soap:Envelope xmlns:xsi=\"http://www.w3.org/2001/XMLSchema-instance\" xmlns:xsd=\"http://www.w3.org/2001/XMLSchema\" xmlns:soap=\"http://schemas.xmlsoap.org/soap/envelope/\">\n  <soap:Body>\n    <AddItemToOrder xmlns=\"globdata\">\n      <ServiceKey>{{auth.apiKey}}</ServiceKey>\n      <SessionID>{{context.mosCouponSessionId}}</SessionID>\n      <OrderID xsi:nil=\"true\" />\n      <NewCoupon>\n        <CustomerID>{{form.customerId}}</CustomerID>\n        <TariffID>{{form.tariffId}}</TariffID>\n        <TariffZoneIDs>\n          <int>{{form.tariffZoneId}}</int>\n        </TariffZoneIDs>\n        <Price>{{form.price}}</Price>\n        <Description>{{form.description}}</Description>\n        <ValidFrom>{{form.validFrom}}</ValidFrom>\n        <ValidTill>{{form.validTill}}</ValidTill>\n        <IsTest>true</IsTest>\n      </NewCoupon>\n      <TokenID>{{form.tokenId}}</TokenID>\n      <ExternalUserID xsi:nil=\"true\" />\n      <ExternalDeskID xsi:nil=\"true\" />\n    </AddItemToOrder>\n  </soap:Body>\n</soap:Envelope>"
          },
          "remember": {
            "mosCouponPrice": "{{form.price}}"
          },
          "expected": {
            "status": 200,
            "assertions": [
              {
                "regex": "<AddItemToOrderResult>[\\s\\S]*?<Result>[\\s\\S]*?<ID>0</ID>",
                "label": "MOS Result.ID = 0",
                "message": "MOS objednávku nevytvořil. Zkontrolujte kombinaci tarifu, zóny a ceny v odpovědi AddItemToOrder."
              },
              {
                "regex": "<OrderID>[1-9][0-9]*</OrderID>",
                "label": "OrderID > 0",
                "message": "MOS nevrátil platné OrderID. Další krok platby objednávky nesmí pokračovat."
              }
            ]
          },
          "extractRegex": {
            "mosCouponOrderId": "<OrderID>([1-9][0-9]*)</OrderID>",
            "mosCouponCouponId": "<CouponID>([1-9][0-9]*)</CouponID>"
          }
        },
        {
          "id": "mos-coupon-set-order-paid",
          "title": "Potvrdit platbu objednávky",
          "description": "Zavolá SetOrderPaid s kancelářskou platbou a aktivuje testovací kupón přiřazený k tokenu.",
          "requiresContext": ["mosCouponSessionId", "mosCouponOrderId", "mosCouponPrice"],
          "fields": [
            {
              "name": "orderId",
              "label": "OrderID",
              "type": "number",
              "value": "{{context.mosCouponOrderId}}"
            },
            {
              "name": "paymentType",
              "label": "PaymentType",
              "type": "select",
              "value": "3",
              "options": [
                { "value": "3", "text": "3 - karta v kanceláři" },
                { "value": "4", "text": "4 - hotovost" }
              ]
            },
            {
              "name": "orderPrice",
              "label": "OrderPrice",
              "type": "number",
              "value": "{{context.mosCouponPrice}}",
              "step": 0.01
            }
          ],
          "request": {
            "method": "POST",
            "path": "/services/MOSservice.asmx",
            "contentType": "text/xml; charset=utf-8",
            "headers": {
              "SOAPAction": "\"globdata/SetOrderPaid\""
            },
            "body": "<?xml version=\"1.0\" encoding=\"utf-8\"?>\n<soap:Envelope xmlns:xsi=\"http://www.w3.org/2001/XMLSchema-instance\" xmlns:xsd=\"http://www.w3.org/2001/XMLSchema\" xmlns:soap=\"http://schemas.xmlsoap.org/soap/envelope/\">\n  <soap:Body>\n    <SetOrderPaid xmlns=\"globdata\">\n      <ServiceKey>{{auth.apiKey}}</ServiceKey>\n      <SessionID>{{context.mosCouponSessionId}}</SessionID>\n      <OrderID>{{form.orderId}}</OrderID>\n      <PaymentType>{{form.paymentType}}</PaymentType>\n      <OrderPrice>{{form.orderPrice}}</OrderPrice>\n    </SetOrderPaid>\n  </soap:Body>\n</soap:Envelope>"
          },
          "expected": {
            "status": 200,
            "assertions": [
              {
                "regex": "<SetOrderPaidResult>[\\s\\S]*?<ID>0</ID>",
                "label": "MOS Result.ID = 0",
                "message": "MOS nepotvrdil zaplacení objednávky. Kupón proto nemusel vzniknout."
              }
            ]
          }
        },
        {
          "id": "mos-coupon-get-coupons",
          "title": "Zobrazit kupóny na identifikátoru",
          "description": "Načte kupóny přiřazené k vybranému TokenID, aby bylo možné ověřit, že se testovací kupón po zaplacení skutečně objevil.",
          "requiresContext": ["mosCouponSessionId", "mosCouponTokenId"],
          "fields": [
            {
              "name": "tokenId",
              "label": "TokenID",
              "type": "number",
              "value": "{{context.mosCouponTokenId}}"
            },
            {
              "name": "loadAllCoupons",
              "label": "Rozsah",
              "type": "select",
              "value": "true",
              "options": [
                { "value": "true", "text": "Všechny kupóny" },
                { "value": "false", "text": "Jen aktuálně dostupné" }
              ]
            }
          ],
          "request": {
            "method": "POST",
            "path": "/services/MOSservice.asmx",
            "contentType": "text/xml; charset=utf-8",
            "headers": {
              "SOAPAction": "\"globdata/GetCoupons\""
            },
            "body": "<?xml version=\"1.0\" encoding=\"utf-8\"?>\n<soap:Envelope xmlns:xsi=\"http://www.w3.org/2001/XMLSchema-instance\" xmlns:xsd=\"http://www.w3.org/2001/XMLSchema\" xmlns:soap=\"http://schemas.xmlsoap.org/soap/envelope/\">\n  <soap:Body>\n    <GetCoupons xmlns=\"globdata\">\n      <ServiceKey>{{auth.apiKey}}</ServiceKey>\n      <SessionID>{{context.mosCouponSessionId}}</SessionID>\n      <TokenID>{{form.tokenId}}</TokenID>\n      <LoadAllCoupons>{{form.loadAllCoupons}}</LoadAllCoupons>\n    </GetCoupons>\n  </soap:Body>\n</soap:Envelope>"
          },
          "expected": {
            "status": 200,
            "assertions": [
              {
                "regex": "<GetCouponsResult>[\\s\\S]*?<Result>[\\s\\S]*?<ID>0</ID>",
                "label": "MOS Result.ID = 0",
                "message": "MOS nevrátil korektní odpověď při načtení kupónů."
              },
              {
                "regex": "<CouponInfoRecord",
                "label": "alespoň jeden kupón",
                "message": "Pro vybraný identifikátor nebyl nalezen žádný kupón. Nákup tedy ve skutečnosti nedoběhl."
              }
            ]
          },
          "selection": {
            "buttonLabel": "Označit kupón",
            "selectedButtonLabel": "Označeno",
            "emptyTitle": "Žádné kupóny",
            "emptyText": "Pro vybraný identifikátor MOS nevrátil žádný kupón. Zkontrolujte TokenID a případně přepněte rozsah na všechny kupóny.",
            "sourceRegex": {
              "itemPattern": "<CouponInfoRecord[^>]*>([\\s\\S]*?)</CouponInfoRecord>",
              "fields": {
                "couponId": "<CouponID>([^<]+)</CouponID>",
                "customerId": "<CustomerID>([^<]+)</CustomerID>",
                "customStatusName": "<CustomStatusName>([^<]*)</CustomStatusName>",
                "status": "<Status>([^<]+)</Status>",
                "tariffId": "<TariffID>([^<]+)</TariffID>",
                "tariffName": "<TariffName>([^<]*)</TariffName>",
                "name": "<Name>([^<]*)</Name>",
                "dateTimeFrom": "<DateTimeFrom>([^<]+)</DateTimeFrom>",
                "dateTimeTo": "<DateTimeTo>([^<]+)</DateTimeTo>",
                "zones": "<Zones>([^<]*)</Zones>",
                "price": "<Price>([^<]+)</Price>",
                "orderId": "<OrderID>([^<]+)</OrderID>",
                "tokenId": "<TokenID>([^<]+)</TokenID>",
                "tokenName": "<TokenName>([^<]*)</TokenName>"
              }
            },
            "store": {
              "mosCouponDisplayedCouponId": "$.couponId"
            }
          }
        }
      ]
    }
  ]
}
