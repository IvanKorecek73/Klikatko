{
  "version": 2,
  "defaultProjectId": "ticket-service",
  "projects": [
    {
      "id": "ticket-service",
      "name": "Ticket Service",
      "description": "Historické a aktivní packy pro původní Ticket Service testy.",
      "manifest": "ticket-service/index.json",
      "defaultBaseUrl": "/api",
      "auth": {
        "type": "jwt",
        "panelTitle": "Přístup (JWT)",
        "jwtLabel": "Bearer token",
        "jwtPlaceholder": "Vložte platný JWT bearer token"
      },
      "defaultEnvironmentId": "ticket-local",
      "environments": [
        {
          "id": "ticket-local",
          "name": "LOCAL",
          "targetBaseUrl": "http://localhost:5087"
        }
      ]
    },
