              "platform": "{{auth.platform}}",
              "osVersion": "{{auth.osVersion}}",
              "appVersion": "{{auth.appVersion}}",
              "model": "{{auth.model}}"
            },
            "deviceLanguage": "{{auth.deviceLanguage}}",
            "deviceMessagingToken": "{{auth.deviceMessagingToken}}"
          },
          "anonymous": {
            "path": "/v1/auth/anonymous",
            "buttonText": "Vytvořit anonymní session",
            "sessionKind": "anonymous",
            "body": {
              "deviceId": "{{auth.deviceId}}",
              "deviceName": "{{auth.deviceName}}",
              "deviceMetadata": {
                "platform": "{{auth.platform}}",
                "osVersion": "{{auth.osVersion}}",
                "appVersion": "{{auth.appVersion}}",
                "model": "{{auth.model}}"
              },
              "deviceLanguage": "{{auth.deviceLanguage}}",
              "deviceMessagingToken": "{{auth.deviceMessagingToken}}"
            },
            "response": {
              "accessTokenPath": "$.accessToken",
              "refreshTokenPath": "$.refreshToken",
              "expiresAtPath": "$.expiresAt",
              "identityIdPath": "$.identityId",
              "deviceIdField": "deviceId"
            }
          },
          "response": {
            "accessTokenPath": "$.accessToken",
            "refreshTokenPath": "$.refreshToken",
            "expiresAtPath": "$.expiresAt",
            "identityIdPath": "$.identityId",
            "emailPath": "$.email",
            "displayNamePath": "$.displayName",
            "deviceIdField": "deviceId"
          }
        },
        "refresh": {
          "path": "/v1/auth/token",
          "buttonText": "Obnovit přihlášení",
          "body": {
            "refreshToken": "{{session.refreshToken}}",
            "deviceId": "{{session.deviceId}}"
          },
          "response": {
            "accessTokenPath": "$.accessToken",
            "refreshTokenPath": "$.refreshToken",
            "expiresAtPath": "$.expiresAt",
            "identityIdPath": "$.identityId",
            "emailPath": "$.email",
            "displayNamePath": "$.displayName",
            "deviceIdField": "deviceId"
          }
        },
        "logout": {
          "path": "/v1/auth/logout",
          "buttonText": "Odhlásit",
          "attachAccessToken": true,
          "body": {
            "deviceId": "{{session.deviceId}}",
            "refreshToken": "{{session.refreshToken}}"
          }
        },
        "sessionRenew": {
          "path": "/v1/auth/session",
          "buttonText": "Obnovit MOS session",
          "attachAccessToken": true,
          "body": {
            "email": "{{auth.email}}",
            "password": "{{auth.password}}"
          }
        }
      },
      "defaultEnvironmentId": "pidlitacka-local",
      "environments": [
        {
          "id": "pidlitacka-local",
          "name": "LOCAL",
          "targetBaseUrl": "https://localhost:7261"
        },
        {
          "id": "pidlitacka-integration",
          "name": "INTEGRAČNÍ",
          "targetBaseUrl": "https://pidl2-backend.int.pidlitacka.cz/"
        }
