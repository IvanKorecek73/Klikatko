    {
      "id": "pidlitacka-ticket-967-transfer-existing-ticket",
      "title": "Task 967 - poslat existující dostupnou jízdenku",
      "description": "Bez nákupu: vybere odesílatele, jednu z jeho dostupných jízdenek a příjemce; po převodu ověří novou jízdenku v zásobníku příjemce.",
      "requiresAuth": false,
      "smoke": false,
      "manualInputRequired": true,
      "autoTags": false,
      "tags": ["tickets", "task-967", "transfer", "two-users"],
      "app": {
        "section": "tickets",
        "title": "Rychle poslat jízdenku",
        "subtitle": "Bez nákupu, s kontrolou příjemce"
      },
      "instructions": [
        "Odesílatele i příjemce lze vybrat z uložených účtů nebo zadat ručně; u ručně zadaného účtu doplňte heslo.",
        "Ručně zadané heslo se použije jen v tomto běhu scénáře a neukládá se do localStorage.",
        "Odesílatel musí mít alespoň jednu neaktivovanou jízdenku ve stavu AVAILABLE. Scénář nic nenakupuje."
      ],
      "steps": [
        {
          "id": "ticket-967-quick-login-sender",
          "title": "Vybrat a přihlásit odesílatele",
          "description": "Vyberte uložený účet nebo ručně zadejte účet, z jehož zásobníku se má jízdenka poslat.",
          "fields": [
            {
              "name": "ticket967QuickSenderEmail",
              "label": "Odesílatel – uložený nebo ručně zadaný e-mail",
              "type": "select",
              "optionsSource": "pidlitacka-auth-profiles",
              "allowCustomValue": true,
              "customInputType": "email",
              "value": "",
              "placeholder": "Vyberte účet nebo napište e-mail",
              "help": "Uložené účty se nabízejí při psaní; lze zadat i jiný e-mail."
            },
            {
              "name": "ticket967QuickSenderPassword",
              "label": "Heslo ručně zadaného odesílatele",
              "type": "password",
              "value": "",
              "placeholder": "Nevyplňujte pro uložený účet",
              "help": "Povinné jen tehdy, když e-mail není mezi uloženými účty. Heslo se nikam neukládá."
