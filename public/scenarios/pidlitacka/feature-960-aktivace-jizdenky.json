{
  "version": 1,
  "name": "PidLitacka - task 960: aktivace jízdenky",
  "description": "Autonomní lokální E2E scénáře aktivace zakoupených jízdenek přes BE PidLitacka a Ticket Service.",
  "scenarios": [
    {
      "id": "pidlitacka-ticket-960-activate-fixed-now",
      "title": "Task 960 - aktivovat pevnou jízdenku nyní",
      "description": "Aktivuje AVAILABLE pražskou jízdenku, bezpečně zopakuje shodný požadavek a ověří aktivní sekci.",
      "requiresAuth": true,
      "smoke": false,
      "manualInputRequired": false,
      "tags": ["tickets", "task-960", "activation", "fixed-zones", "idempotency", "local-fixture"],
      "app": {
        "section": "tickets",
        "title": "Jízdné",
        "subtitle": "Aktivace nyní bez volby pásem"
      },
      "instructions": [
        "Scénář je určen pouze pro LOCAL prostředí a potřebnou AVAILABLE jízdenku si připraví automaticky pro přihlášené identityId.",
        "Lokální fixture bridge je omezený na izolovanou databázi Tickets a nahrazuje pouze chybějící nákup z tasku 957.",
        "Vlastní aktivace vždy vede přes Klikátko → BE PidLitacka → Ticket Service.",
        "Opakovaný PATCH používá stejný Idempotency-Key a musí vrátit tutéž aktivaci, nikoli provést reaktivaci."
      ],
      "steps": [
        {
          "id": "ticket-960-fixed-create-fixture",
          "title": "Automaticky připravit koupenou jízdenku",
          "description": "V izolované lokální databázi vytvoří pro přihlášeného uživatele jednu pevnou jízdenku ve stavu AVAILABLE.",
          "request": {
            "method": "POST",
            "path": "/__harness/fixtures/task-960",
            "headers": { "X-Klikatko-Local-Fixture": "task-960" },
            "body": {
              "userId": "{{session.identityId}}",
              "variant": "fixed",
              "count": 1
            }
          },
          "expected": {
            "status": 201,
            "assertions": [
              { "path": "$.count", "equals": 1 },
              { "path": "$.items[0].status", "equals": "AVAILABLE" },
              { "path": "$.items[0].productId", "equals": 960001 }
            ]
          },
          "extract": { "ticket960FixedFulfillmentId": "$.items[0].fulfillmentId" }
        },
        {
          "id": "ticket-960-fixed-register-device",
          "title": "Připravit zařízení pro aktivaci",
          "description": "Zaregistruje aktuální instalaci v Ticket Service a uloží jeho deviceId.",
          "fields": [
            { "name": "deviceIdentifier", "label": "Identifikátor instalace", "value": "{{auth.deviceId}}", "hidden": true },
            { "name": "deviceModel", "label": "Model zařízení", "value": "{{auth.model}}", "hidden": true },
            { "name": "platform", "label": "Platforma", "value": "{{auth.platform}}", "hidden": true },
            { "name": "idempotencyKey", "label": "Idempotency-Key", "value": "{{uuid}}", "hidden": true }
          ],
          "request": {
            "method": "POST",
            "path": "/v1/client/tickets/devices",
            "headers": { "Idempotency-Key": "{{form.idempotencyKey}}" },
            "body": {
              "deviceIdentifier": "{{form.deviceIdentifier}}",
              "deviceModel": "{{form.deviceModel}}",
              "platform": "{{form.platform}}"
            }
          },
          "expected": {
            "status": 201,
            "assertions": [
              { "path": "$.deviceId", "notEmpty": true },
              { "path": "$.deviceIdentifier", "equals": "{{form.deviceIdentifier}}" }
            ]
          },
          "extract": { "ticket960FixedDeviceId": "$.deviceId" }
        },
        {
          "id": "ticket-960-fixed-select-available",
          "title": "Ověřit koupenou jízdenku v zásobníku",
          "description": "Načte pouze AVAILABLE fulfillmenty a ověří právě připravenou pevnou jízdenku.",
          "requiresContext": ["ticket960FixedFulfillmentId"],
          "request": { "method": "GET", "path": "/v1/client/tickets?limit=100&offset=0&status=AVAILABLE" },
          "expected": {
            "status": 200,
            "assertions": [
              {
                "path": "$.items",
                "containsItem": {
                  "fulfillmentId": "{{context.ticket960FixedFulfillmentId}}",
                  "productId": 960001,
                  "status": "AVAILABLE"
                },
                "message": "Automaticky připravená pevná jízdenka se nevrátila v AVAILABLE zásobníku."
              }
            ]
          }
        },
        {
          "id": "ticket-960-fixed-activate-now",
          "title": "Aktivovat jízdenku nyní",
          "description": "Neposílá pásma ani validSince; výsledný stav, ochranu a platnost přebírá z Tickets.",
          "requiresContext": ["ticket960FixedDeviceId", "ticket960FixedFulfillmentId"],
          "fields": [
            { "name": "idempotencyKey", "label": "Idempotency-Key", "value": "{{uuid}}", "hidden": true }
          ],
          "request": {
            "method": "PATCH",
            "path": "/v1/client/tickets/{{context.ticket960FixedFulfillmentId}}",
            "headers": { "Idempotency-Key": "{{form.idempotencyKey}}" },
            "body": {
              "zones": null,
              "validSince": null,
              "deviceId": "{{context.ticket960FixedDeviceId}}"
            }
          },
          "remember": { "ticket960FixedActivationKey": "{{form.idempotencyKey}}" },
          "extract": {
            "ticket960FixedStatus": "$.status",
            "ticket960FixedEtd": "$.etd"
          },
          "expected": {
            "status": 200,
            "assertions": [
              { "path": "$.fulfillmentId", "equals": "{{context.ticket960FixedFulfillmentId}}" },
              { "sourcePath": "$.status", "regex": "^(FULFILLED|IN_PROTECTION_DELAY)$", "message": "Tickets nevrátil aktivovaný stav." },
              { "path": "$.deviceId", "equals": "{{context.ticket960FixedDeviceId}}" },
              { "path": "$.validSince", "notEmpty": true },
              { "path": "$.validUntil", "notEmpty": true },
              { "path": "$.activationProtection", "atLeast": 0 },
              { "path": "$.etd", "notEmpty": true }
            ]
          }
        },
        {
          "id": "ticket-960-fixed-retry",
          "title": "Ověřit bezpečné opakování aktivace",
          "description": "Zopakuje stejné tělo se stejným klíčem a ověří nezměněný podepsaný ETD; ten obsahuje hranice platnosti i podpis aktivace.",
          "requiresContext": [
            "ticket960FixedDeviceId",
            "ticket960FixedFulfillmentId",
            "ticket960FixedActivationKey",
            "ticket960FixedStatus",
            "ticket960FixedEtd"
          ],
          "request": {
            "method": "PATCH",
            "path": "/v1/client/tickets/{{context.ticket960FixedFulfillmentId}}",
            "headers": { "Idempotency-Key": "{{context.ticket960FixedActivationKey}}" },
            "body": {
              "zones": null,
              "validSince": null,
              "deviceId": "{{context.ticket960FixedDeviceId}}"
            }
          },
          "expected": {
            "status": 200,
            "assertions": [
              { "path": "$.fulfillmentId", "equals": "{{context.ticket960FixedFulfillmentId}}" },
              { "path": "$.status", "equals": "{{context.ticket960FixedStatus}}" },
              { "path": "$.validSince", "notEmpty": true },
              { "path": "$.validUntil", "notEmpty": true },
              {
                "path": "$.etd",
                "equals": "{{context.ticket960FixedEtd}}",
                "message": "Opakovaný požadavek vrátil jiný podepsaný ETD a mohl provést novou aktivaci."
              }
            ]
          }
        },
        {
          "id": "ticket-960-fixed-list-active",
          "title": "Ověřit jízdenku v aktivní sekci",
          "description": "Načte stavy pro aktivní a naplánovanou sekci; FE nad nimi ještě filtruje validUntil > nyní.",
          "requiresContext": ["ticket960FixedFulfillmentId", "ticket960FixedStatus"],
          "request": {
            "method": "GET",
            "path": "/v1/client/tickets?limit=100&offset=0&status=FULFILLED%2CIN_PROTECTION_DELAY"
          },
          "expected": {
            "status": 200,
            "assertions": [
              {
                "path": "$.items",
                "containsItem": {
                  "fulfillmentId": "{{context.ticket960FixedFulfillmentId}}",
                  "status": "{{context.ticket960FixedStatus}}"
                }
              }
            ]
          }
        }
      ]
    },
