{
  "version": 1,
  "name": "PidLitacka - klientská data",
  "description": "Scénáře pro ověření, zda má přihlášený uživatel založený klientský profil a osobní údaje.",
  "scenarios": [
    {
      "id": "client-status-current-user",
      "title": "Klientská data - stav přihlášeného uživatele",
      "description": "Načte stav klientského profilu pro aktuálně přihlášeného uživatele. Scénář je obecný a nevyžaduje konkrétní stav účtu.",
      "requiresAuth": true,
      "smoke": true,
      "manualInputRequired": false,
      "tags": [
        "profile",
        "client-data",
        "client-check"
      ],
      "app": {
        "section": "profile",
        "title": "Profil",
        "subtitle": "Klientská data"
      },
      "instructions": [
        "Nejprve se přihlaste v panelu Přístup.",
        "Spusťte krok a ověřte, jaký stav klientských dat backend pro daného uživatele vrací.",
        "Možné stavy jsou InactiveUser, Missing, PendingPersonalData a Completed."
      ],
      "steps": [
        {
          "id": "client-status-current-user-step",
          "title": "Načíst stav klientských dat",
          "description": "Vrátí informaci, zda je přihlášený uživatel už klientem a zda má uložené osobní údaje.",
          "request": {
            "method": "GET",
            "path": "/v1/auth/client/status"
          },
          "expected": {
            "status": 200,
            "assertions": [
              {
                "path": "$.status",
                "notEmpty": true
              }
            ]
          }
        }
      ]
    },
    {
      "id": "client-status-inactive-user",
      "title": "Klientská data - neaktivní uživatel",
      "description": "Ověří stav účtu, který není aktivní a nemůže pokračovat v založení klienta ani ukládání osobních údajů.",
      "requiresAuth": true,
      "smoke": false,
      "manualInputRequired": true,
      "tags": [
        "profile",
        "client-data",
        "client-check",
        "inactive-account",
        "negative"
      ],
      "app": {
        "section": "profile",
        "title": "Profil",
        "subtitle": "Klientská data"
      },
      "instructions": [
        "V panelu Přístup vyberte účet, který existuje, ale není aktivní.",
        "Očekávaný výsledek je InactiveUser: uživatel není aktivní a scénáře založení klienta nesmí pokračovat.",
        "Pokud se vrátí jiný stav, účet není vhodný pro tento konkrétní scénář."
      ],
      "steps": [
        {
          "id": "client-status-inactive-user-step",
          "title": "Ověřit neaktivního uživatele",
          "description": "Kontrola má potvrdit, že přihlášený uživatel není aktivní.",
          "request": {
            "method": "GET",
            "path": "/v1/auth/client/status"
          },
          "expected": {
            "status": 200,
            "outcome": "expectedError",
            "assertions": [
              {
                "path": "$.isUserActive",
                "equals": false
              },
              {
                "path": "$.exists",
                "equals": false
              },
              {
                "path": "$.hasPersonalData",
                "equals": false
              },
              {
                "path": "$.status",
                "equals": "InactiveUser"
              }
            ]
          }
        }
      ]
    },
    {
      "id": "client-status-missing",
      "title": "Klientská data - uživatel bez klienta",
      "description": "Ověří stav účtu, který ještě nemá založený klientský profil v Core MOS.",
      "requiresAuth": true,
      "smoke": false,
      "manualInputRequired": true,
      "tags": [
        "profile",
        "client-data",
        "client-check",
        "missing-client"
      ],
      "app": {
        "section": "profile",
        "title": "Profil",
        "subtitle": "Klientská data"
      },
      "instructions": [
        "V panelu Přístup vyberte nebo přidejte účet, který ještě nemá založený klientský profil.",
        "Očekávaný výsledek je Missing: klient neexistuje a osobní údaje nejsou dostupné.",
        "Pokud se vrátí jiný stav, účet už není vhodný pro tento konkrétní scénář."
      ],
      "steps": [
        {
          "id": "client-status-missing-step",
          "title": "Ověřit chybějícího klienta",
          "description": "Kontrola má potvrdit, že přihlášený uživatel zatím není klientem.",
          "request": {
            "method": "GET",
            "path": "/v1/auth/client/status"
          },
          "expected": {
            "status": 200,
            "assertions": [
              {
                "path": "$.exists",
                "equals": false
              },
              {
                "path": "$.isUserActive",
                "equals": true
              },
              {
                "path": "$.hasPersonalData",
                "equals": false
              },
              {
                "path": "$.status",
                "equals": "Missing"
              }
            ]
          }
        }
      ]
    },
    {
      "id": "client-status-pending-personal-data",
      "title": "Klientská data - klient bez osobních údajů",
      "description": "Ověří stav účtu, který už má klientský profil, ale ještě nemá uložené osobní údaje.",
      "requiresAuth": true,
      "smoke": false,
      "manualInputRequired": true,
      "tags": [
        "profile",
        "client-data",
        "client-check",
        "personal-data"
      ],
      "app": {
        "section": "profile",
        "title": "Profil",
        "subtitle": "Klientská data"
      },
      "instructions": [
        "V panelu Přístup vyberte účet, který má v Core MOS založený klientský profil bez osobních údajů.",
        "Očekávaný výsledek je PendingPersonalData: klient existuje, ale osobní údaje nejsou dostupné.",
        "Tento stav bude důležitý pro navazující scénáře založení nebo uložení osobních údajů."
      ],
      "steps": [
        {
          "id": "client-status-pending-personal-data-step",
          "title": "Ověřit klienta bez osobních údajů",
          "description": "Kontrola má potvrdit, že klient existuje, ale osobní údaje ještě nejsou uložené.",
          "request": {
            "method": "GET",
            "path": "/v1/auth/client/status"
          },
          "expected": {
            "status": 200,
            "assertions": [
              {
                "path": "$.exists",
                "equals": true
              },
              {
                "path": "$.isUserActive",
                "equals": true
              },
              {
                "path": "$.hasPersonalData",
                "equals": false
              },
              {
                "path": "$.status",
                "equals": "PendingPersonalData"
              }
            ]
          }
        }
      ]
    },
    {
      "id": "client-status-completed",
      "title": "Klientská data - klient s osobními údaji",
      "description": "Ověří stav účtu, který má založený klientský profil i uložené osobní údaje.",
      "requiresAuth": true,
      "smoke": false,
      "manualInputRequired": true,
      "tags": [
        "profile",
        "client-data",
        "client-check",
        "personal-data"
      ],
      "app": {
        "section": "profile",
        "title": "Profil",
        "subtitle": "Klientská data"
      },
      "instructions": [
        "V panelu Přístup vyberte účet, který už má uložené osobní údaje.",
        "Očekávaný výsledek je Completed: klient existuje a backend vrátí osobní údaje.",
        "Ve výstupu v mobilu zkontrolujte jméno, e-mail, telefon, datum narození a případně stav fotografie."
      ],
      "steps": [
        {
          "id": "client-status-completed-step",
          "title": "Ověřit klienta s osobními údaji",
          "description": "Kontrola má potvrdit, že klient existuje a osobní údaje jsou dostupné.",
          "request": {
            "method": "GET",
            "path": "/v1/auth/client/status"
          },
          "expected": {
            "status": 200,
            "assertions": [
              {
                "path": "$.exists",
                "equals": true
              },
              {
                "path": "$.isUserActive",
                "equals": true
              },
              {
                "path": "$.hasPersonalData",
                "equals": true
              },
              {
                "path": "$.status",
                "equals": "Completed"
              },
              {
                "path": "$.personalData",
                "notEmpty": true
              }
            ]
          }
        }
      ]
    },
    {
      "id": "client-data-detail",
      "title": "Klientská data - načtení detailu",
      "description": "Načte kompletní klientská data přihlášeného uživatele včetně osobních údajů a dostupných fotografií.",
      "requiresAuth": true,
      "smoke": true,
      "manualInputRequired": false,
      "tags": [
        "profile",
        "client-data",
        "client-read",
        "personal-data",
        "client-photo"
      ],
      "app": {
        "section": "profile",
        "title": "Profil",
        "subtitle": "Klientská data"
      },
      "instructions": [
        "Nejprve se přihlaste v panelu Přístup.",
        "Spusťte krok a v mobilu zkontrolujte osobní údaje a fotografie, pokud je backend vrátí.",
        "Scénář je obecný: u uživatele bez klientských dat může vrátit stav Missing nebo PendingPersonalData."
      ],
      "steps": [
        {
          "id": "client-data-detail-step",
          "title": "Načíst kompletní klientská data",
          "description": "Vrátí stav klienta, osobní údaje, metadata fotografie a případně i obrazová data.",
          "request": {
            "method": "GET",
            "path": "/v1/auth/client/data"
          },
          "expected": {
            "status": 200,
            "assertions": [
              {
                "path": "$.status",
                "notEmpty": true
              }
            ]
          }
        }
      ]
    },
    {
      "id": "client-data-create-and-save",
      "title": "Klientská data - založení klienta a uložení údajů",
      "description": "Ověří celý první průchod: uživatel zatím není klientem, backend založí klientský profil a uloží jeho osobní údaje.",
      "requiresAuth": true,
      "smoke": false,
      "manualInputRequired": true,
      "tags": [
        "profile",
        "client-data",
        "client-save",
        "client-create",
        "personal-data",
        "client-photo"
      ],
      "app": {
        "section": "profile",
        "title": "Profil",
        "subtitle": "Klientská data"
      },
      "instructions": [
        "V panelu Přístup vyberte účet, který ještě nemá založený klientský profil.",
        "První krok musí vrátit Missing.",
        "Druhý krok pošle osobní údaje. Backend má klienta založit a uložit údaje.",
        "Po úspěšném průchodu už účet nebude vhodný pro opakování tohoto scénáře jako nový klient."
      ],
      "steps": [
        {
          "id": "client-data-create-check-missing",
          "title": "Ověřit, že klient zatím neexistuje",
          "description": "Kontrola před uložením údajů má potvrdit, že pro účet ještě neexistuje klientský profil.",
          "request": {
            "method": "GET",
            "path": "/v1/auth/client/status"
          },
          "expected": {
            "status": 200,
            "assertions": [
              {
                "path": "$.exists",
                "equals": false
              },
              {
                "path": "$.isUserActive",
                "equals": true
              },
              {
                "path": "$.status",
                "equals": "Missing"
              }
            ]
          }
        },
        {
          "id": "client-data-create-save",
          "title": "Založit klienta a uložit osobní údaje",
          "description": "Odešle osobní údaje, nastaví souhlas a očekává založení klienta.",
          "fields": [
            {
              "type": "info",
              "label": "Fotografie klienta",
              "text": "Součástí požadavku je alespoň jedna fotografie posílaná jako multipart/form-data. Můžete ponechat obě testovací fotky, vybrat vlastní, nebo jednu z nich odebrat.",
              "items": [
                "Barevná fotografie",
                "Černobílá fotografie"
              ]
            },
            {
              "name": "photoColor",
              "label": "Barevná fotografie",
              "type": "image-file",
              "accept": "image/*",
              "fileName": "klient-foto-color.png",
              "contentType": "image/png",
              "base64": "",
              "help": "Výchozí je malá testovací průkazová fotografie pod limitem 4096 B. Pro reálnější test můžete vybrat vlastní fotografii."
            },
            {
              "name": "photoBw",
              "label": "Černobílá fotografie",
              "type": "image-file",
              "accept": "image/*",
              "fileName": "klient-foto-bw.png",
              "contentType": "image/png",
              "base64": "",
              "help": "Výchozí je malá černobílá testovací průkazová fotografie pod limitem 4096 B. Pokud backend vyžaduje konkrétní podobu, vyberte odpovídající soubor."
            },
            {
              "name": "displayName",
              "label": "Zobrazované jméno",
              "type": "text",
              "value": "Jan Testovací"
            },
            {
              "name": "personalDataConsent",
              "label": "Souhlas s osobními údaji",
              "type": "checkbox",
              "value": true
            },
            {
              "name": "title",
              "label": "Titul",
              "type": "text",
              "value": ""
            },
            {
              "name": "firstName",
              "label": "Jméno",
              "type": "text",
              "value": "Jan"
            },
            {
              "name": "middleName",
              "label": "Prostřední jméno",
              "type": "text",
              "value": ""
            },
            {
              "name": "lastName",
              "label": "Příjmení",
              "type": "text",
              "value": "Testovací"
            },
            {
              "name": "mobile",
              "label": "Telefon",
              "type": "text",
              "value": "+420777888999"
            },
            {
              "name": "dateOfBirth",
              "label": "Datum narození",
              "type": "date",
              "value": "1990-05-20"
            },
            {
              "name": "loginPuk",
              "label": "Login PUK",
              "type": "text",
              "value": "PUK123"
            },
            {
              "name": "registeredNumberIsic",
              "label": "ISIC",
              "type": "text",
              "value": "ISIC123"
            },
            {
              "name": "language",
              "label": "Jazyk",
              "type": "text",
              "value": "cs"
            }
          ],
          "request": {
            "method": "POST",
            "path": "/v1/auth/client/data",
            "contentType": "multipart/form-data",
            "body": {
              "displayName": "{{form.displayName}}",
              "personalDataConsent": "{{form.personalDataConsent}}",
              "title": "{{form.title}}",
              "firstName": "{{form.firstName}}",
              "middleName": "{{form.middleName}}",
              "lastName": "{{form.lastName}}",
              "mobile": "{{form.mobile}}",
              "dateOfBirth": "{{form.dateOfBirth}}",
              "loginPuk": "{{form.loginPuk}}",
              "registeredNumberIsic": "{{form.registeredNumberIsic}}",
              "language": "{{form.language}}",
              "PhotoColor": "{{form.photoColor}}",
              "PhotoBW": "{{form.photoBw}}"
            }
          },
          "expected": {
            "status": 200,
            "assertions": [
              {
                "path": "$.status",
                "equals": "Completed"
              },
              {
                "path": "$.created",
                "equals": true
              },
              {
                "path": "$.personalDataConsentApplied",
                "equals": true
              },
              {
                "path": "$.client.exists",
                "equals": true
              },
              {
                "path": "$.client.isUserActive",
                "equals": true
              },
              {
                "path": "$.client.hasPersonalData",
                "equals": true
              }
            ]
          }
        },
        {
          "id": "client-data-create-verify-completed",
          "title": "Ověřit uložená klientská data",
          "description": "Znovu načte stav klienta a ověří, že osobní údaje jsou dostupné.",
          "request": {
            "method": "GET",
            "path": "/v1/auth/client/status"
          },
          "expected": {
            "status": 200,
            "assertions": [
              {
                "path": "$.status",
                "equals": "Completed"
              },
              {
                "path": "$.isUserActive",
                "equals": true
              },
              {
                "path": "$.hasPersonalData",
                "equals": true
              },
              {
                "path": "$.personalData",
                "notEmpty": true
              }
            ]
          }
        }
      ]
    },
