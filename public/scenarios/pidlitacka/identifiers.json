{
  "version": 1,
  "name": "PidLitacka - identifikatory",
  "description": "REST scenare nad BE PidLitacka pro spravu identifikatoru aktualniho klienta: prejmenovani, blokace a odblokace.",
  "scenarios": [
    {
      "id": "pidlitacka-identifier-rename",
      "title": "PidLitacka identifikator - prejmenovat",
      "description": "Nacte identifikatory prihlaseneho klienta, umozni jeden vybrat, zavola prejmenovani na BE PidLitacka a znovu nacte identifikatory pro kontrolu.",
      "requiresAuth": true,
      "smoke": false,
      "manualInputRequired": true,
      "tags": [
        "identifiers",
        "pidlitacka",
        "rename",
        "mutation"
      ],
      "app": {
        "section": "profile",
        "title": "Identifikatory",
        "subtitle": "Prejmenovani pres BE"
      },
      "instructions": [
        "V zalozce Uzivatel nejdrive pouzijte Prihlasit / obnovit, aby byl pripraven JWT i MOS SessionID.",
        "Scenar vola BE PidLitacka, nikoliv primo Core MOS.",
        "Vyberte existujici identifikator a zadejte novy nazev.",
        "Posledni krok znovu nacte identifikatory, abyste mohli vizualne overit novy nazev."
      ],
      "steps": [
        {
          "id": "pidlitacka-identifiers-rename-select",
          "title": "Vybrat identifikator",
          "description": "Nacte identifikatory aktualniho klienta a umozni vybrat jeden nosic.",
          "request": {
            "method": "GET",
            "path": "/v1/client/identifiers",
            "headers": {
              "X-Device-Id": "{{context.pidCurrentDeviceId}}"
            }
          },
          "expected": {
            "status": 200,
            "assertions": [
              {
                "path": "$.identifiers",
                "lengthAtLeast": 1
              }
            ]
          },
          "selection": {
            "sourcePath": "$.identifiers",
            "buttonLabel": "Prejmenovat tento identifikator",
            "selectedButtonLabel": "Vybrano k prejmenovani",
            "emptyTitle": "Zadne identifikatory",
            "emptyText": "Aktualni klient nema zadny identifikator, ktery by bylo mozne prejmenovat.",
            "store": {
              "pidIdentifierId": "$.identifierId",
              "pidIdentifierOriginalName": "$.name",
              "pidIdentifierType": "$.type",
              "pidIdentifierMaskedValue": "$.maskedPan",
              "pidIdentifierBlockedStatus": "$.blockedStatus"
            }
          }
        },
        {
          "id": "pidlitacka-identifiers-rename-update",
          "title": "Prejmenovat vybrany identifikator",
          "description": "Zavola PUT /v1/client/identifiers/{identifierId}/name.",
          "requiresContext": [
            "pidIdentifierId"
          ],
          "fields": [
            {
              "name": "identifierId",
              "label": "Identifier ID",
              "type": "number",
              "value": "{{context.pidIdentifierId}}"
            },
            {
              "name": "name",
              "label": "Novy nazev",
              "type": "text",
              "value": "Klikatko BE rename {{today}}",
              "placeholder": "Novy nazev identifikatoru"
            }
          ],
          "request": {
            "method": "PUT",
            "path": "/v1/client/identifiers/{{form.identifierId}}/name",
            "body": {
              "name": "{{form.name}}"
            }
          },
          "remember": {
            "pidIdentifierNewName": "{{form.name}}"
          },
          "expected": {
            "status": 200,
            "assertions": [
              {
                "path": "$.status",
                "equals": "Completed"
              },
              {
                "path": "$.identifierId",
                "notEmpty": true
              },
              {
                "path": "$.name",
                "equals": "{{form.name}}"
              },
              {
                "path": "$.steps[0].name",
                "equals": "CustomerResolution"
              },
              {
                "path": "$.steps[0].status",
                "equals": "Completed"
              },
              {
                "path": "$.steps[1].name",
                "equals": "IdentifierResolution"
              },
              {
                "path": "$.steps[1].status",
                "equals": "Completed"
              },
              {
                "path": "$.steps[2].name",
                "equals": "ChangeTokenName"
              }
            ]
          }
        },
        {
          "id": "pidlitacka-identifiers-rename-verify",
          "title": "Zkontrolovat identifikatory po prejmenovani",
          "description": "Znovu nacte identifikatory aktualniho klienta. Vybrany identifikator by mel mit novy nazev.",
          "request": {
            "method": "GET",
            "path": "/v1/client/identifiers",
            "headers": {
              "X-Device-Id": "{{context.pidCurrentDeviceId}}"
            }
          },
          "expected": {
            "status": 200,
            "assertions": [
              {
                "path": "$.identifiers",
                "lengthAtLeast": 1
              }
            ]
          },
          "selection": {
            "sourcePath": "$.identifiers",
            "buttonLabel": "Ulozit kontrolu",
            "selectedButtonLabel": "Kontrola ulozena",
            "store": {
              "pidIdentifierVerifyId": "$.identifierId",
              "pidIdentifierVerifyName": "$.name",
              "pidIdentifierVerifyBlockedStatus": "$.blockedStatus"
            }
          }
        }
      ]
    },
    {
      "id": "pidlitacka-identifier-block",
      "title": "PidLitacka identifikator - zablokovat",
      "description": "Nacte identifikatory prihlaseneho klienta, umozni vybrat nosic a zavola uzivatelskou blokaci pres BE PidLitacka.",
      "requiresAuth": true,
      "smoke": false,
      "manualInputRequired": true,
      "tags": [
        "identifiers",
        "pidlitacka",
        "block",
        "mutation"
      ],
      "app": {
        "section": "profile",
        "title": "Identifikatory",
        "subtitle": "Blokace pres BE"
      },
      "instructions": [
        "V zalozce Uzivatel nejdrive pouzijte Prihlasit / obnovit.",
        "Scenar vola BE PidLitacka. BE si sam dohleda klienta a vola Core MOS ChangeActiveToken.",
        "Vyberte aktivni odblokovany identifikator. Pokud je uz zablokovany uzivatelem, BE ma operaci rizene preskocit.",
        "Posledni krok znovu nacte identifikatory pro kontrolu stavu."
      ],
      "steps": [
        {
          "id": "pidlitacka-identifiers-block-select",
          "title": "Vybrat identifikator k blokaci",
          "description": "Nacte identifikatory klienta. V kartach sledujte Aktivni a Blokace.",
          "request": {
            "method": "GET",
            "path": "/v1/client/identifiers",
            "headers": {
              "X-Device-Id": "{{context.pidCurrentDeviceId}}"
            }
          },
          "expected": {
            "status": 200,
            "assertions": [
              {
                "path": "$.identifiers",
                "lengthAtLeast": 1
              }
            ]
          },
          "selection": {
            "sourcePath": "$.identifiers",
            "buttonLabel": "Blokovat tento identifikator",
            "selectedButtonLabel": "Vybrano k blokaci",
            "emptyTitle": "Zadne identifikatory",
            "emptyText": "Aktualni klient nema zadny identifikator, ktery by bylo mozne blokovat.",
            "store": {
              "pidIdentifierId": "$.identifierId",
              "pidIdentifierName": "$.name",
              "pidIdentifierType": "$.type",
              "pidIdentifierMaskedValue": "$.maskedPan",
              "pidIdentifierBlockedStatus": "$.blockedStatus"
            }
          }
        },
        {
          "id": "pidlitacka-identifiers-block-update",
          "title": "Zablokovat vybrany identifikator",
          "description": "Zavola POST /v1/client/identifiers/{identifierId}/block.",
          "requiresContext": [
            "pidIdentifierId"
          ],
          "fields": [
            {
              "name": "identifierId",
              "label": "Identifier ID",
              "type": "number",
              "value": "{{context.pidIdentifierId}}"
            }
          ],
          "request": {
            "method": "POST",
            "path": "/v1/client/identifiers/{{form.identifierId}}/block"
          },
          "expected": {
            "status": 200,
            "assertions": [
              {
                "path": "$.status",
                "equals": "Completed"
              },
              {
                "path": "$.identifierId",
                "notEmpty": true
              },
              {
                "path": "$.isActive",
                "equals": false
              },
              {
                "path": "$.blockedStatus",
                "equals": "BlockedByUser"
              },
              {
                "path": "$.steps[0].name",
                "equals": "CustomerResolution"
              },
              {
                "path": "$.steps[1].name",
                "equals": "IdentifierResolution"
              },
              {
                "path": "$.steps[2].name",
                "equals": "ChangeActiveToken"
              }
            ]
          }
        },
        {
          "id": "pidlitacka-identifiers-block-verify",
          "title": "Zkontrolovat identifikatory po blokaci",
          "description": "Znovu nacte identifikatory. Vybrany identifikator by mel byt neaktivni a blokovany uzivatelem.",
          "request": {
            "method": "GET",
            "path": "/v1/client/identifiers",
            "headers": {
              "X-Device-Id": "{{context.pidCurrentDeviceId}}"
            }
          },
          "expected": {
            "status": 200,
            "assertions": [
              {
                "path": "$.identifiers",
                "lengthAtLeast": 1
              }
            ]
          },
          "selection": {
            "sourcePath": "$.identifiers",
            "buttonLabel": "Ulozit kontrolu",
            "selectedButtonLabel": "Kontrola ulozena",
            "store": {
              "pidIdentifierVerifyId": "$.identifierId",
              "pidIdentifierVerifyActive": "$.isActive",
              "pidIdentifierVerifyBlockedStatus": "$.blockedStatus"
            }
          }
        }
      ]
    },
    {
      "id": "pidlitacka-identifier-unblock",
      "title": "PidLitacka identifikator - odblokovat",
      "description": "Nacte identifikatory prihlaseneho klienta, umozni vybrat nosic a zavola uzivatelskou odblokaci pres BE PidLitacka.",
      "requiresAuth": true,
      "smoke": false,
      "manualInputRequired": true,
      "tags": [
        "identifiers",
        "pidlitacka",
        "unblock",
        "mutation"
      ],
      "app": {
        "section": "profile",
        "title": "Identifikatory",
        "subtitle": "Odblokace pres BE"
      },
      "instructions": [
        "V zalozce Uzivatel nejdrive pouzijte Prihlasit / obnovit.",
        "Scenar vola BE PidLitacka. BE ma odblokovat pouze uzivatelskou blokaci, ne admin/issuer blokaci.",
        "Vyberte identifikator blokovany uzivatelem. Pokud je uz aktivni, BE ma operaci rizene preskocit.",
        "Posledni krok znovu nacte identifikatory pro kontrolu stavu."
      ],
      "steps": [
        {
          "id": "pidlitacka-identifiers-unblock-select",
          "title": "Vybrat identifikator k odblokovani",
          "description": "Nacte identifikatory klienta. V kartach vyberte identifikator s uzivatelskou blokaci.",
          "request": {
            "method": "GET",
            "path": "/v1/client/identifiers",
            "headers": {
              "X-Device-Id": "{{context.pidCurrentDeviceId}}"
            }
          },
          "expected": {
            "status": 200,
            "assertions": [
              {
                "path": "$.identifiers",
                "lengthAtLeast": 1
              }
            ]
          },
          "selection": {
            "sourcePath": "$.identifiers",
            "buttonLabel": "Odblokovat tento identifikator",
            "selectedButtonLabel": "Vybrano k odblokaci",
            "emptyTitle": "Zadne identifikatory",
            "emptyText": "Aktualni klient nema zadny identifikator, ktery by bylo mozne odblokovat.",
            "store": {
              "pidIdentifierId": "$.identifierId",
              "pidIdentifierName": "$.name",
              "pidIdentifierType": "$.type",
              "pidIdentifierMaskedValue": "$.maskedPan",
              "pidIdentifierBlockedStatus": "$.blockedStatus"
            }
          }
        },
        {
          "id": "pidlitacka-identifiers-unblock-update",
          "title": "Odblokovat vybrany identifikator",
          "description": "Zavola POST /v1/client/identifiers/{identifierId}/unblock.",
          "requiresContext": [
            "pidIdentifierId"
          ],
          "fields": [
            {
              "name": "identifierId",
              "label": "Identifier ID",
              "type": "number",
              "value": "{{context.pidIdentifierId}}"
            }
          ],
          "request": {
            "method": "POST",
            "path": "/v1/client/identifiers/{{form.identifierId}}/unblock"
          },
          "expected": {
            "status": 200,
            "assertions": [
              {
                "path": "$.status",
                "equals": "Completed"
              },
              {
                "path": "$.identifierId",
                "notEmpty": true
              },
              {
                "path": "$.isActive",
                "equals": true
              },
              {
                "path": "$.blockedStatus",
                "equals": "NotBlocked"
              },
              {
                "path": "$.steps[0].name",
                "equals": "CustomerResolution"
              },
              {
                "path": "$.steps[1].name",
                "equals": "IdentifierResolution"
              },
              {
                "path": "$.steps[2].name",
                "equals": "ChangeActiveToken"
              }
            ]
          }
        },
        {
          "id": "pidlitacka-identifiers-unblock-verify",
          "title": "Zkontrolovat identifikatory po odblokovani",
          "description": "Znovu nacte identifikatory. Vybrany identifikator by mel byt aktivni a bez uzivatelske blokace.",
          "request": {
            "method": "GET",
            "path": "/v1/client/identifiers",
            "headers": {
              "X-Device-Id": "{{context.pidCurrentDeviceId}}"
            }
          },
          "expected": {
            "status": 200,
            "assertions": [
              {
                "path": "$.identifiers",
                "lengthAtLeast": 1
              }
            ]
          },
          "selection": {
            "sourcePath": "$.identifiers",
            "buttonLabel": "Ulozit kontrolu",
            "selectedButtonLabel": "Kontrola ulozena",
            "store": {
              "pidIdentifierVerifyId": "$.identifierId",
              "pidIdentifierVerifyActive": "$.isActive",
              "pidIdentifierVerifyBlockedStatus": "$.blockedStatus"
            }
          }
        }
      ]
    },
    {
      "id": "pidlitacka-identifiers-without-device-header",
      "title": "PidLitacka identifikatory - bez hlavicky zarizeni",
      "description": "Overi domnenku, zda GET /v1/client/identifiers spadne, kdyz klient neposle X-Device-Id.",
      "requiresAuth": true,
      "smoke": false,
      "manualInputRequired": false,
      "tags": [
        "identifiers",
        "pidlitacka",
        "current-device",
        "client-read",
        "regression"
      ],
      "app": {
        "section": "profile",
        "title": "Identifikatory",
        "subtitle": "Bez hlavicky zarizeni"
      },
      "instructions": [
        "V zalozce Uzivatel nejdrive pouzijte Prihlasit / obnovit, aby byl pripraven JWT i MOS SessionID.",
        "Scenar zamerne neposila X-Device-Id.",
        "Pokud backend vrati HTTP 200 a pole identifiers, domnenka o padu bez hlavicky je vyvracena. Pokud krok spadne, response a log ukazou realny status a detail chyby."
      ],
      "steps": [
        {
          "id": "pidlitacka-identifiers-without-device-header-get",
          "title": "Nacist identifikatory bez X-Device-Id",
          "description": "Zavola GET /v1/client/identifiers bez hlavicky aktualniho zarizeni a overi, ze endpoint zustane funkcni.",
          "request": {
            "method": "GET",
            "path": "/v1/client/identifiers"
          },
          "expected": {
            "status": 200,
            "assertions": [
              {
                "path": "$.identifiers",
                "lengthAtLeast": 0
              }
            ]
          }
        }
      ]
    },
    {
      "id": "pidlitacka-identifiers-current-device",
      "title": "PidLitacka identifikator - aktualni zarizeni",
      "description": "Overi, ze prihlaseny klient ma tokenizovane MobApp zarizeni a ze pri odeslani X-Device-Id backend oznaci aktualni zarizeni priznakem isCurrentDevice.",
      "requiresAuth": true,
      "smoke": false,
      "manualInputRequired": false,
      "tags": [
        "identifiers",
        "pidlitacka",
        "mobapp",
        "current-device",
        "client-read"
      ],
      "app": {
        "section": "profile",
        "title": "Identifikatory",
        "subtitle": "Aktualni zarizeni"
      },
      "instructions": [
        "V zalozce Uzivatel nejdrive vyberte nebo ulozte profil, ktery ma vyplnene Device ID zarizeni.",
        "Ucet musi mit v MOS/BE tokenizovany alespon jeden MobApp identifikator.",
        "Prvni krok overi, ze profil ma Device ID. Druhy krok overi existenci MobApp identifikatoru, treti posle X-Device-Id a ceka alespon jeden MobApp s isCurrentDevice = true."
      ],
      "steps": [
        {
          "id": "pidlitacka-identifiers-current-device-id-present",
          "title": "Overit Device ID aktualniho zarizeni",
          "description": "Zkontroluje, ze vybrany uzivatelsky profil nebo workflow kontext ma vyplnene Device ID zarizeni. Bez nej nema overeni isCurrentDevice smysl.",
          "customAction": "requireTemplateValue",
          "requireValue": {
            "templates": [
              "{{context.pidCurrentDeviceId}}",
              "{{auth.deviceId}}"
            ],
            "contextKey": "pidCurrentDeviceId",
            "label": "Device ID zarizeni",
            "okMessage": "Device ID je vyplnene a muze byt poslane v hlavicce X-Device-Id.",
            "missingMessage": "Device ID zarizeni neni vyplnene.",
            "missingDetail": "Doplnte Device ID do vybraneho profilu v zalozce Uzivatel, nebo nejdrive ve workflow projdete tokenizaci telefonu. Bez nej by backend spravne vracel isCurrentDevice = null a dalsi kroky scenare by netestovaly aktualni zarizeni."
          }
        },
        {
          "id": "pidlitacka-identifiers-current-device-tokenized",
          "title": "Overit tokenizovane MobApp zarizeni",
          "description": "Nacte identifikatory aktualniho klienta a overi, ze mezi nimi existuje alespon jeden MobApp token.",
          "request": {
            "method": "GET",
            "path": "/v1/client/identifiers",
            "headers": {
              "X-Device-Id": "{{context.pidCurrentDeviceId}}"
            }
          },
          "expected": {
            "status": 200,
            "assertions": [
              {
                "path": "$.identifiers",
                "lengthAtLeast": 1
              },
              {
                "path": "$.identifiers",
                "containsItem": {
                  "type": "MobApp"
                },
                "message": "Aktualni klient nema zadny MobApp identifikator. Nejdrive zarizeni tokenizujte."
              }
            ]
          }
        },
        {
          "id": "pidlitacka-identifiers-current-device-flag",
          "title": "Overit isCurrentDevice pro aktualni zarizeni",
          "description": "Zavola stejny endpoint s hlavickou X-Device-Id podle ulozeneho profilu a overi, ze alespon jeden MobApp identifikator patri aktualnimu zarizeni.",
          "request": {
            "method": "GET",
            "path": "/v1/client/identifiers",
            "headers": {
              "X-Device-Id": "{{context.pidCurrentDeviceId}}"
            }
          },
          "expected": {
            "status": 200,
            "assertions": [
              {
                "path": "$.identifiers",
                "containsItem": {
                  "type": "MobApp",
                  "isCurrentDevice": true
                },
                "message": "Zadny MobApp identifikator nebyl oznacen jako aktualni zarizeni. Zkontrolujte Device ID v profilu uzivatele."
              }
            ]
          }
        }
      ]
    }
  ]
}
