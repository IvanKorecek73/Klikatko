{
  "version": 1,
  "name": "PidLitacka - Parkování",
  "scenarios": [
    {
      "id": "parking-create-and-extend",
      "title": "Parkování - založení a prodloužení",
      "description": "Založí nové parkování, ručně zpracuje výsledek platební brány, zobrazí aktivní relace a historii a stejným způsobem provede prodloužení.",
      "requiresAuth": true,
      "smoke": false,
      "manualInputRequired": true,
      "tags": ["parking", "vehicles", "zones"],
      "instructions": [
        "Nejprve se přihlaste v panelu Přístup.",
        "Volitelně si na začátku vyberte uložené vozidlo. Pokud nic nevyberete, můžete SPZ v dalším kroku zadat ručně.",
        "Volitelně si pak vyberte oblíbenou zónu. Pokud nic nevyberete, můžete kód zóny v dalším kroku zadat ručně.",
        "Po kroku Založit parkování otevřete vrácenou URL platební brány, dokončete platbu a zkopírujte celý návratový payload do kroku Zpracovat výsledek platební brány.",
        "Stejný postup zopakujte i po kroku Prodloužit parkování."
      ],
      "steps": [
        {
          "id": "parking-pick-saved-vehicle",
          "title": "Vybrat uložené vozidlo",
          "description": "Volitelný krok: načte uložená vozidla a umožní jedno z nich vybrat pro následující parkování.",
          "instructions": [
            "Pokud chcete použít uložené vozidlo, vyberte ho v mobilu.",
            "Pokud chcete zadat SPZ ručně, tento krok jen spusťte a pak pokračujte dál bez výběru."
          ],
          "request": {
            "method": "GET",
            "path": "/v1/parking/my-vehicles"
          },
          "selection": {
            "sourcePath": "$",
            "buttonLabel": "Použít pro parkování",
            "selectedButtonLabel": "Vybráno pro parkování",
            "store": {
              "selectedVehicleId": "$.id",
              "selectedVehicleLicensePlate": "$.licensePlate",
              "selectedVehicleName": "$.name"
            }
          },
          "expected": {
            "status": 200
          }
        },
        {
          "id": "parking-pick-favorite-zone",
          "title": "Vybrat oblíbenou zónu",
          "description": "Volitelný krok: načte oblíbené zóny a umožní jednu z nich vybrat pro následující parkování.",
          "instructions": [
            "Pokud chcete použít oblíbenou zónu, vyberte ji v mobilu.",
            "Pokud chcete zadat kód zóny ručně, tento krok jen spusťte a pak pokračujte dál bez výběru."
          ],
          "request": {
            "method": "GET",
            "path": "/v1/accounts/me/favorite-zones"
          },
          "selection": {
            "sourcePath": "$",
            "buttonLabel": "Použít pro parkování",
            "selectedButtonLabel": "Vybráno pro parkování",
            "store": {
              "selectedFavoriteZoneId": "$.id",
              "selectedFavoriteZoneCode": "$.zoneId"
            }
          },
          "expected": {
            "status": 200
          }
        },
        {
          "id": "parking-create-ticket",
          "title": "Založit parkování",
          "description": "Založí novou parkovací relaci a vrátí odkaz na platební bránu.",
          "fields": [
            {
              "name": "licensePlate",
              "label": "SPZ",
              "value": "{{context.selectedVehicleLicensePlate}}",
              "placeholder": "např. 1AB2345"
            },
            {
              "name": "emailAddress",
              "label": "E-mail",
              "value": "{{session.email}}",
              "placeholder": "např. test@example.com",
              "trackDirty": false
            },
            {
              "name": "phoneNumber",
              "label": "Telefon",
              "value": "777555666",
              "placeholder": "např. +420777123456",
              "trackDirty": false
            },
            {
              "name": "parkingSectionCode",
              "label": "Kód parkovací zóny",
              "value": "{{context.selectedFavoriteZoneCode}}",
              "placeholder": "např. P7-0127"
            },
            {
              "name": "requestedMinutes",
              "label": "Počet minut",
              "type": "number",
              "value": "45",
              "min": 1
            },
            {
              "name": "returnUrlFromPaymentGateway",
              "label": "Return URL",
              "value": "http://127.0.0.1:5500/html/GwResponsePage.html"
            }
          ],
          "remember": {
            "licensePlate": "{{form.licensePlate}}",
            "emailAddress": "{{form.emailAddress}}",
            "phoneNumber": "{{form.phoneNumber}}",
            "parkingSectionCode": "{{form.parkingSectionCode}}",
            "requestedMinutes": "{{form.requestedMinutes}}",
            "returnUrlFromPaymentGateway": "{{form.returnUrlFromPaymentGateway}}",
            "selectedVehicleLicensePlate": "{{form.licensePlate}}"
          },
          "request": {
            "method": "POST",
            "path": "/v1/parking/tickets/street-parking",
            "body": {
              "licensePlate": "{{form.licensePlate}}",
              "emailAddress": "{{form.emailAddress}}",
              "phoneNumber": "{{form.phoneNumber}}",
              "parkingSectionCode": "{{form.parkingSectionCode}}",
              "requestedMinutes": "{{form.requestedMinutes}}",
              "paymentDetails": {
                "paymentMethod": "Card",
                "createCardToken": true,
                "cardToken": null,
                "returnUrlFromPaymentGateway": "{{form.returnUrlFromPaymentGateway}}",
                "automaticPaymentResultProcessing": false,
                "isSdkUsed": false,
                "paymentData": null
              },
              "language": "cs"
            }
          },
          "expected": {
            "status": 200
          }
        },
        {
          "id": "parking-process-payment",
          "title": "Zpracovat výsledek platební brány",
          "description": "Po zaplacení v platební bráně předá backendu celý návratový payload.",
          "instructions": [
            "Dokončete platbu v platební bráně.",
            "Zkopírujte celý návratový payload do pole níže."
          ],
          "fields": [
            {
              "name": "gatewayResultPayload",
              "label": "Payload z platební brány",
              "type": "textarea",
              "value": "",
              "rows": 6,
              "placeholder": "payId=...&dttm=...&resultCode=0..."
            }
          ],
          "request": {
            "method": "POST",
            "path": "/v1/parking/payment/gateway-result?saveCard=true&setDefault=true",
            "body": "{{form.gatewayResultPayload}}"
          },
          "expected": {
            "status": 200
          }
        },
        {
          "id": "parking-active-sessions-after-create",
          "title": "Aktivní relace",
          "description": "Načte aktivní parkovací relace a umožní ověřit, že nová relace běží.",
          "request": {
            "method": "GET",
            "path": "/v1/parking/sessions/active"
          },
          "expected": {
            "status": 200
          }
        },
        {
          "id": "parking-history-after-create",
          "title": "Historie relací",
          "description": "Načte historii parkovacích relací.",
          "request": {
            "method": "GET",
            "path": "/v1/parking/sessions/history"
          },
          "expected": {
            "status": 200
          }
        },
        {
          "id": "parking-extend-ticket",
          "title": "Prodloužit parkování",
          "description": "Založí navazující parkování se stejnými údaji a opět vrátí odkaz na platební bránu.",
          "fields": [
            {
              "name": "licensePlate",
              "label": "SPZ",
              "value": "{{context.licensePlate}}",
              "trackDirty": false
            },
            {
              "name": "emailAddress",
              "label": "E-mail",
              "value": "{{context.emailAddress}}",
              "trackDirty": false
            },
            {
              "name": "phoneNumber",
              "label": "Telefon",
              "value": "{{context.phoneNumber}}",
              "trackDirty": false
            },
            {
              "name": "parkingSectionCode",
              "label": "Kód parkovací zóny",
              "value": "{{context.parkingSectionCode}}",
              "trackDirty": false
            },
            {
              "name": "requestedMinutes",
              "label": "Počet minut",
              "type": "number",
              "value": "{{context.requestedMinutes}}",
              "min": 1,
              "trackDirty": false
            },
            {
              "name": "returnUrlFromPaymentGateway",
              "label": "Return URL",
              "value": "{{context.returnUrlFromPaymentGateway}}",
              "trackDirty": false
            }
          ],
          "request": {
            "method": "POST",
            "path": "/v1/parking/tickets/street-parking",
            "body": {
              "licensePlate": "{{form.licensePlate}}",
              "emailAddress": "{{form.emailAddress}}",
              "phoneNumber": "{{form.phoneNumber}}",
              "parkingSectionCode": "{{form.parkingSectionCode}}",
              "requestedMinutes": "{{form.requestedMinutes}}",
              "paymentDetails": {
                "paymentMethod": "Card",
                "createCardToken": true,
                "cardToken": null,
                "returnUrlFromPaymentGateway": "{{form.returnUrlFromPaymentGateway}}",
                "automaticPaymentResultProcessing": false,
                "isSdkUsed": false,
                "paymentData": null
              },
              "language": "cs"
            }
          },
          "expected": {
            "status": 200
          }
        },
        {
          "id": "parking-process-extension-payment",
          "title": "Zpracovat výsledek prodloužení",
          "description": "Po zaplacení prodloužení předá backendu další návratový payload z platební brány.",
          "instructions": [
            "Dokončete druhou platbu v platební bráně.",
            "Zkopírujte celý návratový payload do pole níže."
          ],
          "fields": [
            {
              "name": "gatewayResultPayload",
              "label": "Payload z platební brány",
              "type": "textarea",
              "value": "",
              "rows": 6,
              "placeholder": "payId=...&dttm=...&resultCode=0..."
            }
          ],
          "request": {
            "method": "POST",
            "path": "/v1/parking/payment/gateway-result?saveCard=true&setDefault=true",
            "body": "{{form.gatewayResultPayload}}"
          },
          "expected": {
            "status": 200
          }
        },
        {
          "id": "parking-active-sessions-after-extension",
          "title": "Aktivní relace po prodloužení",
          "description": "Načte aktivní relace po prodloužení parkování.",
          "request": {
            "method": "GET",
            "path": "/v1/parking/sessions/active"
          },
          "expected": {
            "status": 200
          }
        },
        {
          "id": "parking-history-after-extension",
          "title": "Historie po prodloužení",
          "description": "Načte historii relací po prodloužení parkování.",
          "request": {
            "method": "GET",
            "path": "/v1/parking/sessions/history"
          },
          "expected": {
            "status": 200
          }
        }
      ]
    },
    {
      "id": "parking-saved-card-diagnostic",
      "title": "Parkování - platba uloženou kartou",
      "description": "Diagnostický scénář pro ověření, zda se po uložení karty dá stejnou kartou zaplatit další parkování. První průchod může začít prázdným seznamem karet, což je v pořádku.",
      "requiresAuth": true,
      "smoke": false,
      "manualInputRequired": true,
      "tags": ["parking", "payment", "cards", "diagnostics"],
      "instructions": [
        "Nejprve se přihlaste v panelu Přístup.",
        "Na začátku se načtou uložené karty. Prázdný seznam je pro první průchod v pořádku.",
        "Založte parkování s požadavkem na uložení karty, zaplaťte na platební bráně a zpracujte návratový payload se saveCard=true.",
        "Potom znovu načtěte uložené karty, vyberte nově uloženou kartu a založte navazující parkování placené uloženou kartou.",
        "Poslední krok odešle platbu uloženou kartou přes card-token/process. V diagnostické fázi toleruje i chybový status, aby bylo vidět title/detail z backendu."
      ],
      "steps": [
        {
          "id": "parking-saved-cards-before",
          "title": "Načíst uložené karty",
          "description": "Načte aktuální uložené platební karty. Při prvním průchodu může být seznam prázdný.",
          "instructions": [
            "Pokud kartu vidíte, můžete ji vybrat pro pozdější krok platby uloženou kartou.",
            "Pokud je seznam prázdný, pokračujte přípravnými kroky pro vytvoření uložené karty."
          ],
          "request": {
            "method": "GET",
            "path": "/v1/parking/cards"
          },
          "selection": {
            "sourcePath": "$",
            "buttonLabel": "Použít kartu",
            "selectedButtonLabel": "Karta vybrána",
            "store": {
              "selectedPaymentCardId": "$.id",
              "selectedPaymentCardName": "$.cardholderName",
              "selectedPaymentCardMaskedNumber": "$.maskedPan",
              "selectedPaymentCardExpirationMonth": "$.expirationMonth",
              "selectedPaymentCardExpirationYear": "$.expirationYear"
            }
          },
          "expected": {
            "statusIn": [200, 404]
          }
        },
        {
          "id": "parking-saved-card-pick-vehicle",
          "title": "Vybrat uložené vozidlo",
          "description": "Volitelně načte uložená vozidla a umožní vybrat SPZ pro parkování. Pokud uživatel žádné vozidlo nemá, krok je stále validní a SPZ se zadá ručně.",
          "instructions": [
            "Pokud chcete použít uložené vozidlo, vyberte ho v mobilu.",
            "Pokud seznam vozidel není dostupný nebo je prázdný, pokračujte dál a SPZ doplňte ručně."
          ],
          "request": {
            "method": "GET",
            "path": "/v1/parking/my-vehicles"
          },
          "selection": {
            "sourcePath": "$",
            "buttonLabel": "Použít pro parkování",
            "selectedButtonLabel": "Vybráno pro parkování",
            "store": {
              "selectedVehicleId": "$.id",
              "selectedVehicleLicensePlate": "$.licensePlate",
              "selectedVehicleName": "$.name"
            }
          },
          "expected": {
            "statusIn": [200, 404]
          }
        },
        {
          "id": "parking-saved-card-create-tokenizing-ticket",
          "title": "Založit parkování s uložením karty",
          "description": "Založí parkování tak, aby platební flow mohlo vytvořit token uložené karty.",
          "skipWhen": {
            "contextExists": "selectedPaymentCardId"
          },
          "fields": [
            {
              "name": "licensePlate",
              "label": "SPZ",
              "type": "text",
              "value": "{{context.selectedVehicleLicensePlate}}",
              "placeholder": "např. 1AB2345"
            },
            {
              "name": "emailAddress",
              "label": "E-mail",
              "type": "email",
              "value": "{{session.email}}",
              "placeholder": "např. test@example.com",
              "trackDirty": false
            },
            {
              "name": "phoneNumber",
              "label": "Telefon",
              "type": "text",
              "value": "777888999",
              "trackDirty": false
            },
            {
              "name": "parkingSectionCode",
              "label": "Zóna",
              "type": "text",
              "value": "P7-0127"
            },
            {
              "name": "requestedMinutes",
              "label": "Délka parkování",
              "type": "number",
              "value": "30",
              "min": 15,
              "step": 15,
              "suffix": "min"
            },
            {
              "name": "savePaymentCard",
              "label": "Uložit kartu pro další použití",
              "type": "select",
              "value": "true",
              "valueType": "boolean",
              "options": [
                {
                  "value": "true",
                  "text": "Ano, uložit kartu"
                },
                {
                  "value": "false",
                  "text": "Ne, jen zaplatit"
                }
              ]
            },
            {
              "name": "returnUrlFromPaymentGateway",
              "label": "Návratová URL",
              "type": "url",
              "value": "http://127.0.0.1:5500/html/GwResponsePage.html"
            }
          ],
          "request": {
            "method": "POST",
            "path": "/v1/parking/tickets/street-parking",
            "body": {
              "licensePlate": "{{form.licensePlate}}",
              "emailAddress": "{{form.emailAddress}}",
              "phoneNumber": "{{form.phoneNumber}}",
              "parkingSectionCode": "{{form.parkingSectionCode}}",
              "requestedMinutes": "{{form.requestedMinutes}}",
              "paymentDetails": {
                "paymentMethod": "Card",
                "savePaymentCard": "{{form.savePaymentCard}}",
                "returnUrlFromPaymentGateway": "{{form.returnUrlFromPaymentGateway}}",
                "automaticPaymentResultProcessing": false,
                "isSdkUsed": false,
                "paymentData": null
              },
              "language": "cs"
            }
          },
          "expected": {
            "status": 200
          },
          "remember": {
            "savePaymentCard": "{{form.savePaymentCard}}"
          },
          "extract": {
            "savedCardRegistrationTicketId": "$.ticket.ticketId"
          }
        },
        {
          "id": "parking-saved-card-process-registration-payment",
          "title": "Zpracovat výsledek platební brány",
          "description": "Po zaplacení na platební bráně vložte celý návratový payload. Volání má uložit kartu pro další použití.",
          "skipWhen": {
            "contextExists": "selectedPaymentCardId"
          },
          "fields": [
            {
              "name": "gatewayResultPayload",
              "label": "Návratový payload z platební brány",
              "type": "textarea",
              "rows": 5,
              "placeholder": "payId=...&dttm=...&resultCode=0&..."
            }
          ],
          "request": {
            "method": "POST",
            "path": "/v1/parking/payment/gateway-result?saveCard={{context.savePaymentCard}}&setDefault={{context.savePaymentCard}}",
            "body": "{{form.gatewayResultPayload}}"
          },
          "expected": {
            "status": 200
          }
        },
        {
          "id": "parking-saved-cards-after",
          "title": "Vybrat uloženou kartu",
          "description": "Znovu načte uložené karty a umožní vybrat kartu pro platbu dalšího parkování.",
          "skipWhen": {
            "contextExists": "selectedPaymentCardId"
          },
          "instructions": [
            "Vyberte kartu, kterou chcete použít pro další platbu.",
            "Do dalšího kroku se předvyplní ID uložené karty. Samotný token karty se z API nevrací a v Klikátku se nezadává."
          ],
          "request": {
            "method": "GET",
            "path": "/v1/parking/cards"
          },
          "selection": {
            "sourcePath": "$",
            "buttonLabel": "Použít kartu",
            "selectedButtonLabel": "Karta vybrána",
            "store": {
              "selectedPaymentCardId": "$.id",
              "selectedPaymentCardName": "$.cardholderName",
              "selectedPaymentCardMaskedNumber": "$.maskedPan",
              "selectedPaymentCardExpirationMonth": "$.expirationMonth",
              "selectedPaymentCardExpirationYear": "$.expirationYear"
            }
          },
          "expected": {
            "statusIn": [200, 404]
          }
        },
        {
          "id": "parking-create-extension-with-saved-card",
          "title": "Prodloužit parkování uloženou kartou",
          "description": "Založí navazující parkování se stejnými údaji a vybranou uloženou kartou.",
          "fields": [
            {
              "name": "licensePlate",
              "label": "SPZ",
              "type": "text",
              "value": "{{context.selectedVehicleLicensePlate}}",
              "placeholder": "např. 1AB2345"
            },
            {
              "name": "emailAddress",
              "label": "E-mail",
              "type": "email",
              "value": "{{session.email}}",
              "placeholder": "např. test@example.com",
              "trackDirty": false
            },
            {
              "name": "phoneNumber",
              "label": "Telefon",
              "type": "text",
              "value": "777888999",
              "trackDirty": false
            },
            {
              "name": "parkingSectionCode",
              "label": "Zóna",
              "type": "text",
              "value": "P7-0127"
            },
            {
              "name": "requestedMinutes",
              "label": "Délka parkování",
              "type": "number",
              "value": "30",
              "min": 15,
              "step": 15,
              "suffix": "min"
            },
            {
              "name": "savedPaymentCardId",
              "label": "ID uložené karty",
              "type": "text",
              "value": "{{context.selectedPaymentCardId}}",
              "placeholder": "Vyberte kartu v předchozím kroku"
            },
            {
              "name": "returnUrlFromPaymentGateway",
              "label": "Návratová URL",
              "type": "url",
              "value": "http://127.0.0.1:5500/html/GwResponsePage.html"
            }
          ],
          "request": {
            "method": "POST",
            "path": "/v1/parking/tickets/street-parking",
            "body": {
              "licensePlate": "{{form.licensePlate}}",
              "emailAddress": "{{form.emailAddress}}",
              "phoneNumber": "{{form.phoneNumber}}",
              "parkingSectionCode": "{{form.parkingSectionCode}}",
              "requestedMinutes": "{{form.requestedMinutes}}",
              "paymentDetails": {
                "paymentMethod": "SavedCard",
                "savedPaymentCardId": "{{form.savedPaymentCardId}}",
                "returnUrlFromPaymentGateway": "{{form.returnUrlFromPaymentGateway}}",
                "automaticPaymentResultProcessing": false,
                "isSdkUsed": false,
                "additionalBrowserData": {
                  "acceptHeader": "text/html,application/xhtml+xml,application/xml;q=0.9,image/avif,image/webp,image/apng,*/*;q=0.8",
                  "javaEnabled": false,
                  "language": "cs-CZ",
                  "colorDepth": 24,
                  "screenWidth": 390,
                  "screenHeight": 844,
                  "timezone": -60,
                  "userAgent": "Mozilla/5.0 (iPhone; CPU iPhone OS 17_4 like Mac OS X) AppleWebKit/605.1.15 (KHTML, like Gecko) Version/17.4 Mobile/15E148 Safari/604.1",
                  "challengeWindowSize": "05",
                  "javascriptEnabled": true
                },
                "paymentData": null
              },
              "language": "cs"
            }
          },
          "expected": {
            "status": 200
          },
          "extract": {
            "savedCardPaymentTicketId": "$.ticket.ticketId"
          }
        },
        {
          "id": "parking-process-saved-card-payment",
          "title": "Odeslat platbu uloženou kartou",
          "description": "Odešle platbu navazujícího parkování přes uloženou kartu.",
          "fields": [
            {
              "name": "ticketId",
              "label": "Ticket ID",
              "type": "text",
              "value": "{{context.savedCardPaymentTicketId}}",
              "placeholder": "Ticket ID z předchozího kroku"
            },
            {
              "name": "savedPaymentCardId",
              "label": "ID uložené karty",
              "type": "text",
              "value": "{{context.selectedPaymentCardId}}",
              "placeholder": "Vybraná uložená karta"
            }
          ],
          "request": {
            "method": "POST",
