        {
          "id": "account-resend-active-user",
          "title": "Zkusit znovu odeslat aktivaci",
          "description": "Pokusí se znovu poslat aktivační e-mail pro již aktivní účet.",
          "fields": [
            {
              "name": "userName",
              "label": "E-mail",
              "value": "{{context.userName}}",
              "trackDirty": false
            },
            {
              "name": "language",
              "label": "Jazyk",
              "type": "select",
              "value": "cs",
              "options": [
                { "value": "cs", "text": "Čeština" },
                { "value": "en", "text": "English" }
              ]
            }
          ],
          "request": {
            "method": "POST",
            "path": "/v1/auth/register/resend-activation",
            "body": {
              "userName": "{{form.userName}}",
              "language": "{{form.language}}"
            }
          },
          "expected": {
            "status": 400,
            "outcome": "expectedError"
          }
        }
      ]
    },
    {
      "id": "password-recovery-active-user",
      "title": "Obnova hesla - hladký průběh",
      "description": "Ověří obnovení hesla pro existující aktivní účet přes e-mailový token.",
      "smoke": false,
      "manualInputRequired": true,
      "requiresAuth": true,
      "requiresAnonymousAuth": true,
      "tags": ["account", "password"],
      "instructions": [
        "V panelu Přihlášení vyberte Anonymní uživatel a vytvořte anonymní session.",
        "Použijte e-mail existujícího aktivního uživatele.",
        "Po odeslání recovery e-mailu otevřete schránku, zkopírujte token z odkazu a vložte ho do kroku Resetovat heslo."
      ],
      "steps": [
        {
          "id": "password-recovery-request-active",
          "title": "Požádat o obnovu hesla",
          "description": "Pošle e-mail s odkazem pro obnovu hesla.",
          "fields": [
            {
              "name": "email",
              "label": "E-mail",
              "value": "",
              "placeholder": "např. aktivni.uzivatel@example.com"
            },
            {
              "name": "language",
              "label": "Jazyk",
              "type": "select",
              "value": "cs",
              "options": [
                { "value": "cs", "text": "Čeština" },
                { "value": "en", "text": "English" }
              ]
            },
            {
              "name": "daysValid",
              "label": "Platnost odkazu ve dnech",
              "type": "number",
              "value": 1,
              "min": 1,
              "step": 1
            }
          ],
          "remember": {
            "email": "{{form.email}}"
          },
          "request": {
            "method": "POST",
            "path": "/v1/auth/password/recovery",
            "body": {
              "email": "{{form.email}}",
              "language": "{{form.language}}",
              "daysValid": "{{form.daysValid}}"
            }
          },
          "expected": {
            "status": 200,
            "assertions": [
              { "path": "$.expiresAtUtc", "notEmpty": true }
            ]
          }
        },
        {
          "id": "password-recovery-reset-active",
          "title": "Resetovat heslo",
          "description": "Nastaví nové heslo pomocí tokenu z e-mailu.",
          "instructions": [
            "Do pole Token vložte hodnotu query parametru token z odkazu v e-mailu.",
            "Nové heslo musí splňovat pravidla backendu."
          ],
          "fields": [
            {
              "name": "token",
              "label": "Token z e-mailu",
              "value": "",
              "placeholder": "Vložte token z query parametru token"
            },
            {
              "name": "newPassword",
              "label": "Nové heslo",
              "type": "password",
              "value": "",
              "placeholder": "Zadejte nové heslo"
            }
          ],
          "request": {
            "method": "POST",
            "path": "/v1/auth/password/reset",
            "body": {
              "token": "{{form.token}}",
              "newPassword": "{{form.newPassword}}"
            }
          },
          "expected": {
            "status": 200,
            "assertions": [
              { "path": "$.passwordChanged", "equals": true }
            ]
          }
        }
      ]
    },
